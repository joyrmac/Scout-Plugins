{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "scout/reviews",
	"title": "Scout Reviews",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Your reviews from Google and other platforms, with the real overall rating and a link to each original.",
	"keywords": [ "reviews", "testimonials", "google", "rating" ],
	"textdomain": "scout-reviews",
	"attributes": {
		"layout": { "type": "string", "default": "grid", "enum": [ "grid", "row", "list" ] },
		"count": { "type": "integer", "default": 0 },
		"source": { "type": "string", "default": "" },
		"featured": { "type": "boolean", "default": false },
		"minRating": { "type": "integer", "default": 0 },
		"showSummary": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./editor.js"
}
